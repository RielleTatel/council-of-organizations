SUPABASE_ACCESS_TOKEN=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me
RESEND_API_KEY=replace-me
RESEND_FROM_EMAIL=cms@your-verified-domain.com
CMS_OWNER_EMAIL=owner@your-domain.com
CMS_SITE_URL=https://coa-z-adzu.netlify.app
CMS_LOCAL_ORIGIN=http://localhost:5173
